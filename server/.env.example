# Copy this file to .env on the server and fill in real values.
# See docs/CPANEL_DEPLOYMENT.md for the full cPanel setup walkthrough.

PORT=5050
NODE_ENV=production

# --- Database (MySQL / MariaDB, set up via cPanel's "MySQL Databases" tool) -----------------
# Preferred: a single connection URL.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME
# Alternative: discrete fields (used to build DATABASE_URL if it's left blank) — handy on hosts
# whose "Setup Node.js App" env-var UI is easier to fill in as separate fields.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_CONNECTION_LIMIT=10
# DB_TIMEZONE=Z   # how DATETIME values are read and written; unset follows the host machine. Set Z once the host is UTC.

# Public URL of the deployed React client (used for CORS + cookie settings).
CLIENT_URL=https://tasks.vjsconnect.com

# --- Clustering / Redis (leave both as shown below on shared/Passenger hosting) -------------
# cPanel's "Setup Node.js App" runs your app under Passenger, which manages its own process
# model — do NOT let this app also fork its own cluster workers there. Force single-process
# mode by setting this to 1 (or omitting it in development, where it already defaults to 1).
CLUSTER_WORKERS=1
# Only read when CLUSTER_WORKERS > 1 (multi-process Socket.io fan-out + shared rate-limit
# store). Not needed, and not connected to, when CLUSTER_WORKERS=1 — leave unset on cPanel
# unless you specifically have a Redis instance available.
# REDIS_URL=redis://localhost:6379

# Org-local timezone offset from UTC, in minutes (e.g. 330 = IST/UTC+5:30). Used by the
# checklist recurrence engine to compute "today" in the org's local time.
CHECKLIST_TIMEZONE_OFFSET_MINUTES=330

# --- Auth -------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-string
# Access/refresh token lifetimes are configured from Admin -> Settings now, not env vars.
# POST /auth/register is closed unless this is "true" (admins create accounts otherwise).
ALLOW_SELF_REGISTRATION=false

# --- Cookies (set both for production HTTPS) --------------------------------------------
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Optional integrations (leave blank to disable the corresponding feature) -------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

DOUBLETICK_API_KEY=
DOUBLETICK_WEBHOOK_SECRET=
DOUBLETICK_SENDER_NUMBER=
