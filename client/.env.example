# Copy to .env.local for local dev overrides, or .env.production for a manual prod build.
# In CI/CD (.github/workflows/deploy.yml), this is instead injected at build time from the
# repo's VITE_API_URL Actions variable — see docs/CICD_DEPLOYMENT.md.

# The API's own subdomain (see docs/CICD_DEPLOYMENT.md for why it's a separate subdomain from
# the app itself, not a /api path prefix). Falls back to http://localhost:5050 when unset, which
# is right for local dev against the server run via `npm run dev` in server/.
VITE_API_URL=https://api.karyaos.in
